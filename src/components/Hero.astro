---
import PCBTraceBackground from './PCBTraceBackground.astro';
import brandLogo from '../assets/Brand-Clear.svg';
---

<main>
  <PCBTraceBackground speed={3} />
  <div class="card">
    <div class="hab">
      <strong>Ingeniero Electrónico · Programador · Diseñador</strong>
    </div>
    <div class="name">
      <h1>Juan Galíndez.</h1>
    </div>
    <div class="pseud">JACKESTAR</div>
  </div>
  <div class="hero">
    <div class="profile">
      <img src="#" alt="Profile" />
      <div class="brand">
        <img src={brandLogo.src} alt="Brand" />
      </div>
    </div>
  </div>
</main>

<style>
  main {
    color: var(--text-body);
    display: flex;
    flex-direction: column; /* mobile: vertical */
    min-height: 90vh;
    min-height: 90svh;
  }

  .card {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 2rem 1rem;
    user-select: none;
  }

  .hab strong {
    letter-spacing: 0.12em;
    word-spacing: 0.5em;
    font-size: clamp(0.9rem, 3.5vw, 1.25rem);
    font-weight: 400;
  }

  .name h1 {
    color: var(--text-title);
    margin: 0.5rem 0 0.5rem 1rem;
    padding: 0;
    letter-spacing: 0.2em;
    font-size: clamp(3.5rem, 15vw, 6rem);
    user-select: text;
    text-align: left;
  }

  .hero {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem 1rem 3rem;
    box-sizing: border-box;
  }

  .profile {
    position: relative;
    width: min(70vw, 360px);
    aspect-ratio: 1;
    box-sizing: border-box;
  }

  .profile > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 1.5rem;
    background: var(--border);
  }

  .brand {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translate(-50%, 50%);
    width: 30%;
    aspect-ratio: 1;
    background: var(--bg-subtle);
    border-radius: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .brand img {
    display: block;
    width: 90%;
    height: 90%;
    object-fit: contain;
  }

  :root[data-theme='light'] .brand img {
    background: transparent;
    filter: invert(1);
  }

  img {
    text-align: center;
  }

  @media (min-width: 768px) {
    main {
      flex-direction: row;
    }

    .card,
    .hero {
      flex: 1 1 50%;
      min-width: 0;
    }

    .card {
      padding: 2rem;
    }

    .hero {
      padding: 2rem;
    }

    .profile {
      width: min(80%, 420px);
    }
  }
</style>

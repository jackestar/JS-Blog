---
type Trace = [
  x: number,
  y: number,
  length: number,
  horizontal?: boolean,
  inverted?: boolean,
];

interface Props {
  color?: string;
  lineWidth?: number;
  speed?: number;
  lineSpacing?: number;
  traces?: Trace[];
}
const {
  color,
  lineWidth = 3,
  speed = 3,
  lineSpacing = 5,
  traces = [
    [0.35, 0.75, 0.3, true, false],
    [0.35, 0.25, 0.3, true, true],
    [0.65, 0.25, 0.5, false, false],
    [0.35, 0.25, 0.5, false, true],
  ],
} = Astro.props;

const config = JSON.stringify({
  options: {color, lineWidth, speed, lineSpacing},
  traces,
});
---

<pcb-trace-background data-config={config}>
  <canvas aria-hidden="true"></canvas>
</pcb-trace-background>

<style>
  pcb-trace-background {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
<script>
  import PCBTraceAnimation from 'pcb-trace-animation';

  type Trace = [number, number, number, boolean?, boolean?];

  class PCBTraceBackground extends HTMLElement {
    #pcb?: PCBTraceAnimation;
    #observer?: MutationObserver;

    connectedCallback() {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      this.#render();

      // Redraw whenever the theme attribute changes
      this.#observer = new MutationObserver(() => this.#render());
      this.#observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
    }

    disconnectedCallback() {
      this.#observer?.disconnect();
      this.#observer = undefined;
      this.#pcb?.stop();
      this.#pcb = undefined;
    }

    #render() {
      // Stop the previous run and wipe the canvas
      this.#pcb?.stop();

      const canvas = this.querySelector('canvas')!;
      canvas.getContext('2d')?.clearRect(0, 0, canvas.width, canvas.height);

      const {options, traces} = JSON.parse(this.dataset.config ?? '{}') as {
        options: {
          color?: string;
          lineWidth: number;
          speed: number;
          lineSpacing: number;
        };
        traces: Trace[];
      };

      // Read the variable again, so it reflects the new theme
      const color =
        options.color ??
        getComputedStyle(this).getPropertyValue('--bg-hover').trim();

      this.#pcb = new PCBTraceAnimation(canvas, {
        ...options,
        color,
        onComplete: () => this.dispatchEvent(new CustomEvent('pcb:complete')),
      });

      this.#pcb.initCanvas();
      for (const t of traces) this.#pcb.drawLine(...t);
      this.#pcb.start();
    }
  }

  if (!customElements.get('pcb-trace-background')) {
    customElements.define('pcb-trace-background', PCBTraceBackground);
  }
</script>

---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteHeader from './SiteHeader.astro';

interface Props {
  mode?: 'site' | 'blog';
}

//const {locale} = Astro.locals.starlightRoute ?? Astro.props; // depends on Starlight version
//const lang = locale ?? 'en';
const lang = 'es';
const other = lang === 'en' ? 'es' : 'en';

// swap the locale segment in the URL
const altLangHref = Astro.url.pathname.replace(`/${lang}/`, `/${other}/`);
---

<SiteHeader
  mode={Astro.props.mode}
  lang={lang}
  altLangHref={altLangHref}
  homeHref="/"
>
  <Search slot="search" {...Astro.props} />
</SiteHeader>

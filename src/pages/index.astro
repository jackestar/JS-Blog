<style is:global>
  * {
    margin: 0;
    padding: 0;
  }

  *:root {
    --font-color: #222;
    --font-color-highlight: #000;
    --highlight-color: #eee;
    --border-color: #aaa;
    --background-color: #fefefe;
  }
</style>
